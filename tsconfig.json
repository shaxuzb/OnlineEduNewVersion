{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["App.tsx", "index.js", "src/**/*.ts", "src/**/*.tsx", "nativewind-env.d.ts"],
  "exclude": [
    "[locale]/**",
    "android/**",
    "node_modules/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
